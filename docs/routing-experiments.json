  "method": {
    "runtime": "Use the disconnected offline editor, save a synthetic baseline, change one routing selector at a time, SAVE to a new file, inspect the saved JSON and compare adjacent artifacts. No console connection was used.",
    "publication": "Minimal field observations and hashes only. Complete native snapshots, installers and private sessions are not distributed. Tests reconstruct small analysis documents; these are not native editor load templates.",
    "static": "Symbol-sized source-group/count tables and focused native disassembly corroborate the codecs. Shell ELF/objdump inspection, not new REA Evidence; no static engine was configured.",
    "successfulNativeArtifacts": 20,
    "reproduce": [
      "SAVE an offline synthetic baseline as a new snapshot.",
      "Select a destination in Routing; choose the source slot and confirm the destination label changes.",
      "For USR 1–24 edit its logical source, tap and side; for USR 25–56 choose a raw input.",
      "SAVE each change separately, hash the resulting file, and compare the listed JSON Pointer.",
      "Do not treat browsing a source group or a filename as proof that a routing change committed."
    ]
  },
